## 🎓 EJEMPLO COMPLETO DE FEATURE

```typescript
// ===== MODEL: cancha.model.ts =====
export interface Cancha {
  nombre: string;
  idTipoCancha: number;
}

export interface GetCancha extends Cancha {
  idCancha?: number;
  tipoCancha?: TipoCancha;
}

export interface CreateCancha extends Cancha { }
export interface UpdateCancha extends Cancha { idCancha: number; }

// ===== SERVICE: cancha.service.ts =====
@Injectable({ providedIn: 'root' })
export class CanchaService extends BaseService {
  constructor(http: HttpClient) {
    super(http, `${environment.backend.baseApiUrl}/Cancha`);
  }

  get(id: number): Observable<ResponseDto<GetCancha>> {
    return this.getRequest(`/${id}`);
  }

  create(body: CreateCancha): Observable<ResponseDto<GetCancha>> {
    return this.postRequest(``, body);
  }
}

// ===== COMPONENT: cancha.component.ts =====
@Component({
  selector: 'app-cancha',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule, MatButtonModule],
  templateUrl: './cancha.component.html'
})
export class CanchaComponent extends BaseComponent implements OnInit {
  form: FormGroup;
  cancha?: GetCancha;

  constructor(
    private fb: FormBuilder,
    private service: CanchaService,
    @Inject(ViewContainerRef) vcr: ViewContainerRef
  ) {
    super('CANCHAS', vcr);
    this.form = this.fb.group({
      nombre: ['', Validators.required],
      idTipoCancha: ['', Validators.required]
    });
  }

  ngOnInit(): void {
    this.loadCancha(1);
  }

  loadCancha(id: number): void {
    this.fetchById(
      this.service.get(id),
      (data) => this.cancha = data
    );
  }

  onSubmit(): void {
    if (this.form.invalid) {
      Object.keys(this.form.controls).forEach(k =>
        this.form.controls[k].markAsTouched()
      );
      return;
    }

    const body: CreateCancha = this.form.value;
    this.service.create(body).subscribe({
      next: (res) => {
        if (res.isValid) {
          this.openSuccessAlert('Cancha creada exitosamente');
        } else {
          this.openErrorAlert(res);
        }
      },
      error: (err) => this.openAlert(err)
    });
  }
}

// ===== TEMPLATE: cancha.component.html =====
<form [formGroup]="form" (ngSubmit)="onSubmit()">
  <mat-form-field appearance="outline">
    <mat-label>Nombre</mat-label>
    <input matInput formControlName="nombre">
  </mat-form-field>

  <button type="submit" class="btn-primary">
    Guardar
  </button>
</form>
```

