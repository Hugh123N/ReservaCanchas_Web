nombre.dto.ts
nombre.guard.ts
nombre.interceptor.ts
nombre.routes.ts
nombre.constant.ts
```

### Variables y Código
```typescript
// camelCase: variables, propiedades, métodos
selectedDate: DateOption;
loadData() { }

// PascalCase: clases, interfaces, types
export class CanchaService { }
export interface GetCancha { }

// UPPER_SNAKE_CASE: constantes
const ESTADO_CANCHA = { };
const DEFAULT_DELAY = 5000;

// Prefijos booleanos
isLoading: boolean;
